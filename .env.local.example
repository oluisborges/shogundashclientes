# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Meta Ads API
# Tokens are stored per-client in the database, not here
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
NEXT_PUBLIC_META_APP_ID=your_meta_app_id

# Google Sheets / Drive
# Service Account com acesso à pasta do Drive
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID da pasta do Google Drive que contém as planilhas dos clientes
# (ex: https://drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Google Calendar
# ID do calendário "Reuniões - Grupo Shogun"
GOOGLE_CALENDAR_ID=629e99e9290f64bc2cfee442d316645f942f4db76911c300904c822e192658e9@group.calendar.google.com
# Calendário para verificar disponibilidade (freebusy) — "Samurai do Trafego"
GOOGLE_FREEBUSY_CALENDAR_ID=leandrosamurait@gmail.com
# OAuth2 — necessário para criar eventos com convidados
# Obtenha em: Google Cloud Console > Credenciais > OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
